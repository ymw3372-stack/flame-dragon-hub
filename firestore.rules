rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Dashboard administrators, by verified email. This matches the check that
    // worked on the secure-developer-dashboard-email-admin branch. The UID that
    // replaced it was a placeholder ("...caXXXzN...") matching no real account,
    // so isAdmin() was always false and every dashboard read was denied.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'ymw3372@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userBanPath(uid) {
      return /databases/$(database)/documents/userBans/$(uid);
    }

    function isBanned(uid) {
      return exists(userBanPath(uid))
        && get(userBanPath(uid)).data.active == true
        && (
          get(userBanPath(uid)).data.expiresAt == null
          || get(userBanPath(uid)).data.expiresAt > request.time
        );
    }

    function validAuthMetadata(data, uid) {
      return data.uid == uid
        && data.email == request.auth.token.email
        && data.provider == request.auth.token.firebase.sign_in_provider
        && data.emailVerified == (request.auth.token.email_verified == true);
    }

    // Anonymous extension download clicks. No names, emails, IPs or device IDs are stored.
  match /extensionAnalytics/{eventId} {
    // Store only the event type, source and timestamp; no account or device identifier.
    allow create: if request.auth == null
      && request.resource.data.keys().hasOnly(['type', 'source', 'createdAt'])
      && request.resource.data.keys().hasAll(['type', 'source', 'createdAt'])
      && request.resource.data.type in ['download_click', 'install', 'usage_session']
      && (
        (request.resource.data.type == 'download_click' && request.resource.data.source == 'website')
        || (request.resource.data.type in ['install', 'usage_session'] && request.resource.data.source == 'extension')
      )
      && request.resource.data.createdAt is timestamp
      && request.resource.data.createdAt > request.time - duration.value(10, 'm')
      && request.resource.data.createdAt < request.time + duration.value(1, 'm');
    allow read: if isAdmin();
    allow update, delete: if false;
  }

  // One anonymous record per browser profile. The website stores a random
  // ID locally and uses it as the document ID, so repeat visits cannot add rows.
  // Only the verified administrator can read the visitor collection.
  match /programVisitors/{visitorId} {
    allow create: if request.auth == null
      && request.resource.data.keys().hasOnly(['firstSeenAt', 'entryPage'])
      && request.resource.data.keys().hasAll(['firstSeenAt', 'entryPage'])
      && request.resource.data.firstSeenAt is timestamp
      && request.resource.data.firstSeenAt > request.time - duration.value(10, 'm')
      && request.resource.data.firstSeenAt < request.time + duration.value(1, 'm')
      && request.resource.data.entryPage is string
      && request.resource.data.entryPage.size() <= 200;
    allow read: if isAdmin();
    allow update, delete: if false;
  }

  // Moderation records are readable by the owner of that account and by the admin.
  // Only the verified admin can write them, and the admin cannot target their own UID.
  match /userBans/{uid} {
    allow get: if isAdmin() || isOwner(uid);
    allow list: if isAdmin();
    allow create, update: if isAdmin() && request.auth.uid != uid;
    allow delete: if false;
  }


    // Append-only owner audit trail for moderation actions.
    match /moderationLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'action', 'targetUid', 'targetEmail', 'actorUid',
          'reason', 'duration', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'action', 'targetUid', 'targetEmail', 'actorUid',
          'reason', 'duration', 'createdAt'
        ])
        && request.resource.data.action in ['ban', 'unban', 'kick']
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.targetEmail is string
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 300
        && request.resource.data.duration is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

  match /users/{uid} {
      allow read: if isAdmin() || (isOwner(uid) && !isBanned(uid));

      allow create: if isOwner(uid) && !isBanned(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'provider', 'emailVerified',
          'createdAt', 'lastSignInAt', 'updatedAt'
        ])
        && validAuthMetadata(request.resource.data, uid)
        && request.resource.data.provider is string
        && request.resource.data.emailVerified is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSignInAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid) && !isBanned(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'provider', 'emailVerified',
          'lastSignInAt', 'updatedAt'
        ])
        && validAuthMetadata(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastSignInAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /activity/{eventId} {
        allow read: if isAdmin() || (isOwner(uid) && !isBanned(uid));

        allow create: if isOwner(uid) && !isBanned(uid)
          && request.resource.data.keys().hasOnly(['type', 'provider', 'createdAt'])
          && request.resource.data.type in ['register', 'sign_in', 'sign_out']
          && request.resource.data.provider == request.auth.token.firebase.sign_in_provider
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // Public support submissions are append-only. Only the verified owner can
    // read them or change their workflow status.
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
          'reference','name','email','topic','message','attachmentData',
          'attachmentName','attachmentType','status','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'reference','name','email','topic','message','attachmentData',
          'attachmentName','attachmentType','status','createdAt'
        ])
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 8
        && request.resource.data.reference.size() <= 40
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 70
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.topic in ['Bug Report','Suggestion','Account Help','General Contact']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 3000
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt == request.time
        && request.resource.data.attachmentData is string
        && request.resource.data.attachmentData.size() <= 700000
        && request.resource.data.attachmentName is string
        && request.resource.data.attachmentName.size() <= 180
        && request.resource.data.attachmentType in ['', 'image/png', 'image/jpeg', 'image/webp']
        && (
          request.resource.data.attachmentData == ''
          || request.resource.data.attachmentType in ['image/png','image/jpeg','image/webp']
        );
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['New','In Progress','Resolved']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Queue one notification email for the matching contact message. The
    // recipient is fixed so public clients cannot use this as a mail relay.
    match /mail/{mailId} {
      allow create: if request.resource.data.keys().hasOnly(['reference','to','message'])
        && request.resource.data.keys().hasAll(['reference','to','message'])
        && request.resource.data.reference is string
        && request.resource.data.to == ['flame.dragon.hub@gmail.com']
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasOnly(['subject','text'])
        && request.resource.data.message.subject is string
        && request.resource.data.message.subject.size() <= 180
        && request.resource.data.message.text is string
        && request.resource.data.message.text.size() <= 5000
        && existsAfter(/databases/$(database)/documents/contactMessages/$(request.resource.data.reference))
        && getAfter(/databases/$(database)/documents/contactMessages/$(request.resource.data.reference)).data.reference == request.resource.data.reference;
      allow read, update, delete: if isAdmin();
    }
  }
}
