rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The sole dashboard administrator is the verified owner UID.
    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'mPYAzTPWOkZTpzB0caXXXzNHDdg2'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validAuthMetadata(data, uid) {
      return data.uid == uid
        && data.email == request.auth.token.email
        && data.provider == request.auth.token.firebase.sign_in_provider
        && data.emailVerified == (request.auth.token.email_verified == true);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'provider', 'emailVerified',
          'createdAt', 'lastSignInAt', 'updatedAt'
        ])
        && validAuthMetadata(request.resource.data, uid)
        && request.resource.data.provider is string
        && request.resource.data.emailVerified is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSignInAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'provider', 'emailVerified',
          'lastSignInAt', 'updatedAt'
        ])
        && validAuthMetadata(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastSignInAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /activity/{eventId} {
        allow read: if isOwner(uid) || isAdmin();

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['type', 'provider', 'createdAt'])
          && request.resource.data.type in ['register', 'sign_in', 'sign_out']
          && request.resource.data.provider == request.auth.token.firebase.sign_in_provider
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // Publicly readable only when published; only the verified owner can manage posts.
    match /announcements/{announcementId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'published', 'createdAt', 'updatedAt', 'createdBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 90
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1200
        && request.resource.data.published is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published', 'updatedAt'])
        && request.resource.data.published is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Public release notes are readable by everyone; writes remain owner-only.
    match /siteConfig/{configId} {
      allow read: if configId == 'public';
      allow create, update: if isAdmin()
        && configId == 'public'
        && request.resource.data.keys().hasOnly(['version', 'releaseNotes', 'updatedAt'])
        && request.resource.data.version is string
        && request.resource.data.version.size() > 0
        && request.resource.data.version.size() <= 30
        && request.resource.data.releaseNotes is string
        && request.resource.data.releaseNotes.size() <= 1200
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin() && configId == 'public';
    }
  }
}